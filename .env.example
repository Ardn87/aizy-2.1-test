# Django
# En production, remplacer cette valeur par une cle longue et secrete.
# Les alias SECRET_KEY, DEBUG et ALLOWED_HOSTS sont aussi acceptes par settings.py.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_TIME_ZONE=Europe/Paris

# Origines CSRF a renseigner en HTTPS, par exemple :
# CSRF_TRUSTED_ORIGINS=https://factures.example.com
CSRF_TRUSTED_ORIGINS=

# Local : serveur de developpement Django.
DJANGO_START_COMMAND=python manage.py runserver 0.0.0.0:8000

# Production : remplacer DJANGO_START_COMMAND par Gunicorn, par exemple :
# DJANGO_START_COMMAND=gunicorn facture_project.wsgi:application --bind 0.0.0.0:8000 --workers 3 --timeout 60

# Activer ces options uniquement derriere HTTPS.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_USE_X_FORWARDED_PROTO=0

# Port publie par Docker Compose sur l'hote.
WEB_PORT=8000

# Mode de lancement du script:
# - local  : db + web, sans tunnel Cloudflare
# - server : db + web + tunnel Cloudflare
AIZY_DEPLOY_MODE=local

# Nom Docker Compose isole pour eviter les conflits avec d'autres projets.
COMPOSE_PROJECT_NAME=aizy

# PostgreSQL
POSTGRES_DB=facture_db
POSTGRES_USER=facture_user
POSTGRES_PASSWORD=facture_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Stockage local dans le conteneur.
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# IA documentaire OpenAI.
# Sans cle API, les documents sont conserves mais aucune donnee n'est inventee.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Mise en ligne via Cloudflare Tunnel.
# Laisser vide pour demarrer seulement l'application locale.
CLOUDFLARE_TUNNEL_TOKEN=
# Domaine public associe au tunnel, par exemple aizy.sogeta.com.
PUBLIC_HOSTNAME=
